#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE        0
#define FUNC        1

/ {
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1>;
        triggers-per-rotation = <24>;
    };

    macros {
        H_E12: H_E12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(E) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp H &kp U &kp Y &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_0 &kp RETURN &kp DOWN &kp LC(S) &kp LC(S) &kp DOWN>;

            label = "H_E12";
            wait-ms = <200>;
            tap-ms = <0>;
        };

        H_TO: H_TO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(E) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp H &kp U &kp Y &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_1 &kp RETURN &kp DOWN &kp LC(S) &kp LC(S) &kp DOWN>;

            label = "H_TO";
            wait-ms = <200>;
            tap-ms = <0>;
        };

        H_HA: H_HA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(E) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp H &kp U &kp Y &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_2 &kp RETURN &kp DOWN &kp LC(S) &kp LC(S) &kp DOWN>;

            label = "H_HA";
            wait-ms = <200>;
            tap-ms = <0>;
        };

        V_E12: V_E12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(E) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp V &kp I &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_0 &kp RETURN &kp DOWN &kp LC(S) &kp LC(S) &kp DOWN>;

            label = "V_E12";
            wait-ms = <200>;
            tap-ms = <0>;
        };

        V_TO: V_TO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(E) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp V &kp I &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_1 &kp RETURN &kp DOWN &kp LC(S) &kp LC(S) &kp DOWN>;

            label = "V_TO";
            wait-ms = <200>;
            tap-ms = <0>;
        };

        V_HA: V_HA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(E) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp V &kp I &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_2 &kp RETURN &kp DOWN &kp LC(S) &kp LC(S) &kp DOWN>;

            label = "V_HA";
            wait-ms = <200>;
            tap-ms = <0>;
        };

        THIEU: THIEU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp ENTER &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp N &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp NUMBER_0 &kp F5 &kp LEFT_ARROW>;

            label = "THIEU";
            wait-ms = <300>;
        };

        THANHTOAN: THANHTOAN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ENTER &kp F5 &kp LEFT_ARROW>;
            label = "THANHTOAN";
            wait-ms = <300>;
        };

        CHUYENKHOAN: CHUYENKHOAN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp ENTER &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp C &kp F5 &kp LEFT_ARROW>;

            label = "CHUYENKHOAN";
            wait-ms = <300>;
        };

        Chuyen_vo: Chuyen_vo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(T) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp C &kp DOWN_ARROW &kp DOWN_ARROW &kp TAB &kp N6 &kp N4 &kp LS(H) &kp RETURN &kp O &kp RETURN &kp V &kp DOWN_ARROW &kp TAB &kp C &kp K &kp V &kp RETURN &kp RETURN &kp V &kp MINUS>;

            label = "Chuyen_vo";
            wait-ms = <200>;
            tap-ms = <0>;
        };

        Xang_3242: Xang_3242 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(T) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp TAB &kp T &kp P &kp DOWN &kp TAB &kp LS(H) &kp U &kp RETURN &kp MINUS &kp X &kp TAB &kp X &kp G &kp LS(F) &kp NUMBER_4 &kp RETURN &kp LS(H) &kp LS(D) &kp D &kp SPACE>;

            label = "XANG_3242";
            wait-ms = <700>;
            tap-ms = <0>;
        };

        Xang_8841: Xang_8841 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(T) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp TAB &kp T &kp P &kp DOWN &kp TAB &kp LS(V) &kp I &kp E &kp RETURN &kp MINUS &kp X &kp TAB &kp X &kp G &kp LS(F) &kp NUMBER_1 &kp RETURN &kp LS(H) &kp LS(D) &kp D &kp SPACE>;

            label = "XANG_8841";
            wait-ms = <700>;
            tap-ms = <0>;
        };

        Xang_5061: Xang_5061 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(T) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp TAB &kp T &kp P &kp DOWN &kp TAB &kp LS(V) &kp I &kp E &kp RETURN &kp MINUS &kp X &kp TAB &kp X &kp G &kp LS(H) &kp NUMBER_5 &kp RETURN &kp LS(H) &kp LS(D) &kp D &kp SPACE>;

            label = "Xang_5061";
            wait-ms = <700>;
            tap-ms = <0>;
        };

        Dau_3648: Dau_3648 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(T) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp SPACE &kp TAB &kp T &kp P &kp DOWN &kp TAB &kp LS(O) &kp A &kp RETURN &kp MINUS &kp X &kp TAB &kp X &kp G &kp LS(H) &kp RETURN &kp LS(H) &kp LS(D) &kp D &kp SPACE>;

            label = "DAU_3648";
            wait-ms = <700>;
            tap-ms = <0>;
        };

        Lay_gas: Lay_gas {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(T) &kp TAB>,
                <&macro_wait_time 100>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp K &kp DOWN_ARROW &kp TAB &kp K &kp TAB &kp N6 &kp N4 &kp LS(H) &kp RETURN &kp TAB &kp O &kp RETURN &kp G &kp DOWN_ARROW &kp TAB &kp C &kp K &kp G &kp RETURN &kp RETURN &kp G &kp MINUS>;

            label = "Lay_gas";
            tap-ms = <0>;
            wait-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        giaohang_layer {
            // ---------------------------//
            // | Q    | W     | ENCODER | //
            // | A    | S     | D       | //
            // | Z    | X     | FN      | //

            display-name = "GHang_VAT";
            bindings = <
&H_E12  &V_E12  &to 1
&H_TO   &V_TO   &Chuyen_vo
&H_HA   &V_HA   &Lay_gas
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        chixang_layer {
            // --------------------------- //
            // | BT_CLR | none | ENCODER | //
            // | BT_0   | BT_1 | BT_2    | //
            // | BT_3   | BT_4 | trans   | //

            display-name = "Chi_xang";
            bindings = <
&Xang_3242  &Dau_3648  &to 2
&Xang_8841  &none      &none
&Xang_5061  &none      &none
            >;

            sensor-bindings = <&inc_dec_kp (TAB) LS(TAB)>;
        };

        thanhtoan_layer {
            bindings = <
&THIEU        &none  &to 0
&CHUYENKHOAN  &none  &bt BT_NXT
&THANHTOAN    &none  &sys_reset
            >;

            label = "ThanhToan";
            sensor-bindings = <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };
    };
};
