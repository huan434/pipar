#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE        0
#define FUNC        1

/ {
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1>;
        triggers-per-rotation = <24>;
    };

    macros {
        H_E12: H_E12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(E)>,
                <&macro_release>,
                <&kp LC(E)>,
                <&macro_wait_time 200>,
                <&kp TAB &kp TAB &kp H &kp U &kp Y &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp N1 &kp N3 &kp N2 &kp N2 &kp DOWN &kp LC(S)>,
                <&macro_wait_time 300>,
                <&kp LC(S) &kp DOWN>;

            label = "H_E12";
        };

        H_TO: H_TO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(E)>,
                <&macro_release>,
                <&kp LC(E)>,
                <&macro_wait_time 200>,
                <&kp TAB &kp TAB &kp H &kp U &kp Y &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp N1 &kp NUMBER_2 &kp N2 &kp NUMBER_8 &kp DOWN &kp LC(S)>,
                <&macro_wait_time 300>,
                <&kp LC(S) &kp DOWN>;

            label = "H_TO";
        };

        H_HA: H_HA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(E)>,
                <&macro_release>,
                <&kp LC(E)>,
                <&macro_wait_time 200>,
                <&kp TAB &kp TAB &kp H &kp U &kp Y &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp N1 &kp NUMBER_1 &kp N8 &kp NUMBER_8 &kp DOWN &kp LC(S)>,
                <&macro_wait_time 300>,
                <&kp LC(S) &kp DOWN>;

            label = "H_HA";
        };

        V_E12: V_E12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(E)>,
                <&macro_release>,
                <&kp LC(E)>,
                <&macro_wait_time 200>,
                <&kp TAB &kp TAB &kp V &kp I &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp N1 &kp N3 &kp N2 &kp N2 &kp DOWN &kp LC(S)>,
                <&macro_wait_time 300>,
                <&kp LC(S) &kp DOWN>;

            label = "V_E12";
        };

        V_TO: V_TO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(E)>,
                <&macro_release>,
                <&kp LC(E)>,
                <&macro_wait_time 200>,
                <&kp TAB &kp TAB &kp V &kp I &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp N1 &kp NUMBER_2 &kp N2 &kp NUMBER_8 &kp DOWN &kp LC(S)>,
                <&macro_wait_time 300>,
                <&kp LC(S) &kp DOWN>;

            label = "V_TO";
        };

        V_HA: V_HA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(E)>,
                <&macro_release>,
                <&kp LC(E)>,
                <&macro_wait_time 200>,
                <&kp TAB &kp TAB &kp V &kp I &kp LS(TAB) &kp LS(TAB) &kp LS(TAB) &kp DOWN &kp C &kp K &kp H &kp TAB &kp TAB &kp TAB &kp TAB &kp MINUS &kp N1 &kp NUMBER_1 &kp N8 &kp NUMBER_8 &kp DOWN &kp LC(S)>,
                <&macro_wait_time 300>,
                <&kp LC(S) &kp DOWN>;

            label = "V_HA";
        };

        THIEU: THIEU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp ENTER>,
                <&macro_wait_time 200>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp N &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp N0 &kp F5>;

            label = "THIEU";
        };

        THANHTOAN: THANHTOAN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp ENTER>,
                <&macro_wait_time 200>,
                <&kp F5 &kp LEFT_ARROW>;

            label = "THANHTOAN";
        };

        CHUYENKHOAN: CHUYENKHOAN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp ENTER>,
                <&macro_wait_time 200>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp C &kp F5>;

            label = "CHUYENKHOAN";
        };

        XANG_3242: XANG_3242 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(T)>,
                <&macro_release>,
                <&kp LC(T)>,
                <&macro_wait_time 300>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp T &kp P &kp DOWN &kp TAB &kp TAB &kp TAB &kp H &kp U &kp Y &kp TAB &kp TAB &kp LS(P) &kp E &kp T &kp R &kp O &kp L &kp I &kp M &kp E &kp X &kp X &kp TAB &kp TAB &kp TAB &kp TAB &kp C &kp H &kp I &kp MINUS &kp X &kp TAB &kp RIGHT_ARROW &kp N6 &kp N4 &kp LS(F) &kp N4 &kp MINUS &kp N3 &kp N2 &kp N4 &kp N2 &kp TAB &kp TAB &kp LS(H) &kp LS(D) &kp SPACE>;

            label = "XANG_3242";
        };

        XANG_8841: XANG_8841 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(T)>,
                <&macro_release>,
                <&kp LC(T)>,
                <&macro_wait_time 300>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp T &kp P &kp DOWN &kp TAB &kp TAB &kp TAB &kp V &kp TAB &kp TAB &kp LS(P) &kp E &kp T &kp R &kp O &kp L &kp I &kp M &kp E &kp X &kp X &kp TAB &kp TAB &kp TAB &kp TAB &kp C &kp H &kp I &kp MINUS &kp X &kp TAB &kp RIGHT_ARROW &kp N6 &kp N4 &kp LS(F) &kp NUMBER_1 &kp MINUS &kp N8 &kp N8 &kp N4 &kp NUMBER_1 &kp TAB &kp TAB &kp LS(H) &kp LS(D) &kp SPACE>;

            label = "XANG_8841";
        };

        XANG_5061: XANG_5061 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(T)>,
                <&macro_release>,
                <&kp LC(T)>,
                <&macro_wait_time 300>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp T &kp P &kp DOWN &kp TAB &kp TAB &kp TAB &kp V &kp TAB &kp TAB &kp LS(P) &kp E &kp T &kp R &kp O &kp L &kp I &kp M &kp E &kp X &kp X &kp TAB &kp TAB &kp TAB &kp TAB &kp C &kp H &kp I &kp MINUS &kp X &kp TAB &kp RIGHT_ARROW &kp N6 &kp N4 &kp LS(H) &kp N5 &kp MINUS &kp N5 &kp N0 &kp NUMBER_6 &kp NUMBER_1 &kp TAB &kp TAB &kp LS(H) &kp LS(D) &kp SPACE>;

            label = "XANG_5061";
        };

        DAU_3648: DAU_3648 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(T)>,
                <&macro_release>,
                <&kp LC(T)>,
                <&macro_wait_time 300>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp T &kp P &kp DOWN &kp TAB &kp TAB &kp TAB &kp O &kp TAB &kp TAB &kp LS(P) &kp E &kp T &kp R &kp O &kp L &kp I &kp M &kp E &kp X &kp X &kp TAB &kp TAB &kp TAB &kp TAB &kp C &kp H &kp I &kp MINUS &kp X &kp T &kp TAB &kp TAB &kp TAB &kp LS(H) &kp LS(D) &kp SPACE>;

            label = "DAU_3648";
        };

        CHUYENVO: CHUYENVO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(T)>,
                <&macro_release>,
                <&kp LC(T)>,
                <&macro_wait_time 50>,
                <&kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp TAB &kp T &kp H &kp DOWN &kp DOWN_ARROW &kp TAB &kp N6 &kp N4 &kp LS(H) &kp MINUS &kp N3 &kp N6 &kp N4 &kp N8 &kp TAB &kp O &kp TAB &kp V &kp DOWN_ARROW &kp TAB &kp TAB &kp TAB &kp LS(H) &kp LS(D) &kp SPACE &kp LS(C) &kp H &kp U &kp Y &kp E &kp E &kp R &kp N &kp SPACE &kp V &kp O &kp R &kp SPACE &kp Q &kp U &kp A &kp SPACE &kp LS(T) &kp H &kp U &kp SPACE &kp LS(N) &kp G &kp O &kp J &kp C &kp TAB &kp TAB &kp>,
                <&macro_press>;

            label = "CHUYENVO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------//
            // | Q    | W     | ENCODER | //
            // | A    | S     | D       | //
            // | Z    | X     | FN      | //

            display-name = "default";
            bindings = <
&kp TAB         &kp LEFT_WIN    &to 1
&kp BACKSPACE   &kp UP_ARROW    &kp ENTER
&kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        function_layer {
            // --------------------------- //
            // | BT_CLR | none | ENCODER | //
            // | BT_0   | BT_1 | BT_2    | //
            // | BT_3   | BT_4 | trans   | //

            display-name = "function";
            bindings = <
&bt BT_CLR    &none         &to 2
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2
&bt BT_SEL 3  &bt BT_SEL 4  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_2 {
            bindings = <
&kp C_PAUSE  &kp PRINTSCREEN  &to 0
&kp INS      &kp HOME         &kp LC(C)
&kp DELETE   &kp END          &kp LC(V)
            >;
        };
    };
};
